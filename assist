local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

if not player then
	warn("This must be running from a LocalScript.")
	return
end

local camera = workspace.CurrentCamera
while not camera do
	workspace:GetPropertyChangedSignal("CurrentCamera"):Wait()
	camera = workspace.CurrentCamera
end

local mouse = player:GetMouse()

local enabled = false
local targetHead = nil

local AIM_SPEED = 0.06
local TARGET_REFRESH = 0.15

local function findTarget()
	local bestHead = nil
	local bestDistance = math.huge

	camera = workspace.CurrentCamera
	if not camera then
		return nil
	end

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			local character = otherPlayer.Character
			local head = character and character:FindFirstChild("Head")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")

			if head and humanoid and humanoid.Health > 0 then
				local screenPos, visible =
					camera:WorldToViewportPoint(head.Position)

				if visible and screenPos.Z > 0 then
					local dx = screenPos.X - mouse.X
					local dy = screenPos.Y - mouse.Y
					local distance = math.sqrt(dx * dx + dy * dy)

					if distance < bestDistance then
						bestDistance = distance
						bestHead = head
					end
				end
			end
		end
	end

	return bestHead
end

task.spawn(function()
	while true do
		if enabled then
			if not targetHead or not targetHead.Parent then
				targetHead = findTarget()
			else
				local character = targetHead.Parent
				local humanoid = character:FindFirstChildOfClass("Humanoid")

				if not humanoid or humanoid.Health <= 0 then
					targetHead = findTarget()
				end
			end
		else
			targetHead = nil
		end

		task.wait(TARGET_REFRESH)
	end
end)

RunService:BindToRenderStep(
	"AimLockCamera",
	Enum.RenderPriority.Camera.Value + 1,
	function()
		if not enabled or not targetHead or not targetHead.Parent then
			return
		end

		camera = workspace.CurrentCamera
		if not camera then
			return
		end

		local humanoid =
			targetHead.Parent:FindFirstChildOfClass("Humanoid")

		if not humanoid or humanoid.Health <= 0 then
			targetHead = nil
			return
		end

		local cameraPosition = camera.CFrame.Position

		local targetCFrame = CFrame.lookAt(
			cameraPosition,
			targetHead.Position
		)

		camera.CFrame = camera.CFrame:Lerp(
			targetCFrame,
			AIM_SPEED
		)
	end
)

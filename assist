local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local mouse = player:GetMouse()

local enabled = false
local targetHead = nil

-- Lower = slower/smoother
local AIM_SPEED = 0.06

-- Higher = less frequent target scanning
local TARGET_REFRESH = 0.15

local function findTarget()
	local bestHead = nil
	local bestDistance = math.huge

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			local character = otherPlayer.Character
			local head = character and character:FindFirstChild("Head")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")

			if head and humanoid and humanoid.Health > 0 then
				local screenPos, visible =
					camera:WorldToViewportPoint(head.Position)

				if visible and screenPos.Z > 0 then
					local dx = screenPos.X - mouse.X
					local dy = screenPos.Y - mouse.Y
					local distance = math.sqrt(dx * dx + dy * dy)

					if distance < bestDistance then
						bestDistance = distance
						bestHead = head
					end
				end
			end
		end
	end

	return bestHead
end

-- Find a target periodically instead of every frame
task.spawn(function()
	while true do
		if enabled then
			if not targetHead
				or not targetHead.Parent then

				targetHead = findTarget()
			else
				local humanoid =
					targetHead.Parent:FindFirstChildOfClass("Humanoid")

				if not humanoid or humanoid.Health <= 0 then
					targetHead = findTarget()
				end
			end
		else
			targetHead = nil
		end

		task.wait(TARGET_REFRESH)
	end
end)

-- Smoothly rotate the camera every frame
RunService:BindToRenderStep(
	"AimLockCamera",
	Enum.RenderPriority.Camera.Value + 1,
	function()
		if not enabled or not targetHead or not targetHead.Parent then
			return
		end

		local humanoid =
			targetHead.Parent:FindFirstChildOfClass("Humanoid")

		if not humanoid or humanoid.Health <= 0 then
			targetHead = nil
			return
		end

		local cameraPosition = camera.CFrame.Position

		local targetCFrame = CFrame.lookAt(
			cameraPosition,
			targetHead.Position
		)

		-- Smooth camera movement
		camera.CFrame = camera.CFrame:Lerp(
			targetCFrame,
			AIM_SPEED
		)
	end
)

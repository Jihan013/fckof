local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

--==================================================
-- SETTINGS
--==================================================

local AIM_KEY = Enum.KeyCode.Q

local FOV_RADIUS = 180
local MAX_DISTANCE = 500
local SMOOTHNESS = 0.40

local REQUIRE_LINE_OF_SIGHT = true

-- Auto-fire settings
local AUTO_FIRE = true
local FIRE_COOLDOWN = 0.12

-- Your game's weapon RemoteEvent
local FireWeapon = ReplicatedStorage:WaitForChild("FireWeapon")

--==================================================
-- VARIABLES
--==================================================

local aiming = false
local targetHead = nil
local lastShot = 0

--==================================================
-- GUI
--==================================================

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AimAssistGUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Name = "AimToggle"
button.Size = UDim2.fromOffset(130, 45)
button.Position = UDim2.new(1, -150, 1, -75)

button.BackgroundColor3 = Color3.fromRGB(170, 50, 50)

button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.Text = "AIM: OFF"
button.TextScaled = true
button.Font = Enum.Font.GothamBold

button.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = button

--==================================================
-- ENEMY CHECK
--==================================================

local function isEnemy(player)

	if player == LocalPlayer then
		return false
	end

	if LocalPlayer.Team ~= nil and player.Team ~= nil then
		return LocalPlayer.Team ~= player.Team
	end

	return true
end

--==================================================
-- LINE OF SIGHT
--==================================================

local function canSee(head)

	if not REQUIRE_LINE_OF_SIGHT then
		return true
	end

	local character = LocalPlayer.Character

	if not character then
		return false
	end

	local origin = Camera.CFrame.Position
	local direction = head.Position - origin

	local params = RaycastParams.new()

	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {
		character
	}

	local result = workspace:Raycast(
		origin,
		direction,
		params
	)

	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(head.Parent)
end

--==================================================
-- FIND TARGET
--==================================================

local function findTarget()

	local mousePosition =
		UserInputService:GetMouseLocation()

	local closestHead = nil
	local closestScreenDistance = FOV_RADIUS
	local closestWorldDistance = MAX_DISTANCE

	for _, player in ipairs(Players:GetPlayers()) do

		if isEnemy(player) and player.Character then

			local character = player.Character

			local head =
				character:FindFirstChild("Head")

			local humanoid =
				character:FindFirstChildOfClass("Humanoid")

			if head
				and humanoid
				and humanoid.Health > 0 then

				local screenPosition, visible =
					Camera:WorldToViewportPoint(
						head.Position
					)

				if visible and screenPosition.Z > 0 then

					local screenDistance =
						(
							Vector2.new(
								screenPosition.X,
								screenPosition.Y
							) - mousePosition
						).Magnitude

					local worldDistance =
						(
							Camera.CFrame.Position
							- head.Position
						).Magnitude

					if screenDistance < closestScreenDistance
						and worldDistance < closestWorldDistance
						and canSee(head) then

						closestScreenDistance =
							screenDistance

						closestWorldDistance =
							worldDistance

						closestHead = head

					end
				end
			end
		end
	end

	return closestHead
end

--==================================================
-- AUTO FIRE
--==================================================

local function autoShoot()

	if not AUTO_FIRE then
		return
	end

	if not aiming then
		return
	end

	if not targetHead then
		return
	end

	local now = os.clock()

	if now - lastShot < FIRE_COOLDOWN then
		return
	end

	-- Make sure target is close to the crosshair
	local screenPosition, visible =
		Camera:WorldToViewportPoint(
			targetHead.Position
		)

	if not visible or screenPosition.Z <= 0 then
		return
	end

	local mousePosition =
		UserInputService:GetMouseLocation()

	local crosshairDistance =
		(
			Vector2.new(
				screenPosition.X,
				screenPosition.Y
			) - mousePosition
		).Magnitude

	-- Only fire when crosshair is actually on target
	if crosshairDistance <= 12 then

		lastShot = now

		-- YOUR game's firing event
		FireWeapon:FireServer(
			targetHead.Position
		)

	end
end

--==================================================
-- BUTTON UPDATE
--==================================================

local function updateButton()

	if aiming then

		button.Text = "AIM: ON"
		button.BackgroundColor3 =
			Color3.fromRGB(50, 170, 70)

	else

		button.Text = "AIM: OFF"
		button.BackgroundColor3 =
			Color3.fromRGB(170, 50, 50)

	end
end

--==================================================
-- TOGGLE
--==================================================

local function toggleAim()

	aiming = not aiming

	if aiming then
		targetHead = findTarget()
	else
		targetHead = nil
	end

	updateButton()
end

button.MouseButton1Click:Connect(toggleAim)

--==================================================
-- KEYBOARD TOGGLE
--==================================================

UserInputService.InputBegan:Connect(function(
	input,
	processed
)

	if processed then
		return
	end

	if input.KeyCode == AIM_KEY then
		toggleAim()
	end
end)

--==================================================
-- AIM + AUTO FIRE LOOP
--==================================================

RunService.RenderStepped:Connect(function()

	if not aiming then
		return
	end

	-- Find target
	if not targetHead
		or not targetHead.Parent then

		targetHead = findTarget()

	end

	if not targetHead then
		return
	end

	local humanoid =
		targetHead.Parent:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid
		or humanoid.Health <= 0 then

		targetHead = findTarget()
		return

	end

	-- Distance check
	local distance =
		(
			Camera.CFrame.Position
			- targetHead.Position
		).Magnitude

	if distance > MAX_DISTANCE then
		targetHead = findTarget()
		return
	end

	-- Visibility check
	if REQUIRE_LINE_OF_SIGHT
		and not canSee(targetHead) then

		targetHead = findTarget()
		return

	end

	-- Aim at head
	local cameraPosition =
		Camera.CFrame.Position

	local direction =
		(targetHead.Position - cameraPosition).Unit

	local desiredCFrame =
		CFrame.lookAt(
			cameraPosition,
			cameraPosition + direction
		)

	Camera.CFrame =
		Camera.CFrame:Lerp(
			desiredCFrame,
			SMOOTHNESS
		)

	-- Auto shoot
	autoShoot()

end)

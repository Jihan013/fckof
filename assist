local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local enabled = false
local targetHead = nil

-- How often to look for a new target
local TARGET_UPDATE_RATE = 0.15

-- 1 = instant, lower = smoother
local AIM_SPEED = 1

local function findTarget()
	local closestHead = nil
	local closestDistance = math.huge
	local cameraPosition = camera.CFrame.Position

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			local character = otherPlayer.Character
			local head = character and character:FindFirstChild("Head")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")

			if head and humanoid and humanoid.Health > 0 then
				local distance = (head.Position - cameraPosition).Magnitude

				if distance < closestDistance then
					closestDistance = distance
					closestHead = head
				end
			end
		end
	end

	return closestHead
end

-- Target selection runs separately instead of every frame
task.spawn(function()
	while true do
		if enabled then
			if not targetHead
				or not targetHead.Parent
				or not targetHead.Parent:FindFirstChildOfClass("Humanoid")
				or targetHead.Parent:FindFirstChildOfClass("Humanoid").Health <= 0 then

				targetHead = findTarget()
			end
		else
			targetHead = nil
		end

		task.wait(TARGET_UPDATE_RATE)
	end
end)

-- Camera update
RunService:BindToRenderStep(
	"AimLock",
	Enum.RenderPriority.Camera.Value + 1,
	function()
		if not enabled or not targetHead or not targetHead.Parent then
			return
		end

		local cameraPosition = camera.CFrame.Position
		local targetPosition = targetHead.Position

		local targetCFrame = CFrame.lookAt(
			cameraPosition,
			targetPosition
		)

		if AIM_SPEED >= 1 then
			camera.CFrame = targetCFrame
		else
			camera.CFrame = camera.CFrame:Lerp(
				targetCFrame,
				AIM_SPEED
			)
		end
	end
)

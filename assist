local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

--// SETTINGS
local AIM_KEY = Enum.KeyCode.Q
local FOV_RADIUS = 180
local MAX_DISTANCE = 500
local SMOOTHNESS = 0.22
local REQUIRE_LINE_OF_SIGHT = true

local aiming = false
local targetHead = nil

--// Check whether a player is an enemy
local function isEnemy(player)
	if player == LocalPlayer then
		return false
	end

	-- Works with normal Roblox Teams
	if LocalPlayer.Team ~= nil and player.Team ~= nil then
		return LocalPlayer.Team ~= player.Team
	end

	return true
end

--// Check if the head can actually be seen
local function canSee(head)
	if not REQUIRE_LINE_OF_SIGHT then
		return true
	end

	local character = LocalPlayer.Character
	if not character then
		return false
	end

	local origin = Camera.CFrame.Position
	local direction = head.Position - origin

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character}

	local result = workspace:Raycast(origin, direction, params)

	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(head.Parent)
end

--// Find the enemy head closest to the crosshair
local function findTarget()
	local mousePosition = UserInputService:GetMouseLocation()

	local bestHead = nil
	local bestScreenDistance = FOV_RADIUS
	local bestWorldDistance = MAX_DISTANCE

	for _, player in ipairs(Players:GetPlayers()) do
		if isEnemy(player) and player.Character then

			local character = player.Character
			local head = character:FindFirstChild("Head")
			local humanoid = character:FindFirstChildOfClass("Humanoid")

			if head and humanoid and humanoid.Health > 0 then

				local screenPosition, visible =
					Camera:WorldToViewportPoint(head.Position)

				if visible and screenPosition.Z > 0 then

					local screenDistance = (
						Vector2.new(screenPosition.X, screenPosition.Y)
						- mousePosition
					).Magnitude

					local worldDistance =
						(Camera.CFrame.Position - head.Position).Magnitude

					if screenDistance < bestScreenDistance
						and worldDistance < bestWorldDistance
						and canSee(head) then

						bestScreenDistance = screenDistance
						bestWorldDistance = worldDistance
						bestHead = head
					end
				end
			end
		end
	end

	return bestHead
end

--// Hold Q to activate
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if input.KeyCode == AIM_KEY then
		aiming = true
		targetHead = findTarget()
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == AIM_KEY then
		aiming = false
		targetHead = nil
	end
end)

--// Aim
RunService.RenderStepped:Connect(function()
	if not aiming then
		return
	end

	-- Find a new target if necessary
	if not targetHead
		or not targetHead.Parent
		or not targetHead.Parent:FindFirstChildOfClass("Humanoid")
		or targetHead.Parent:FindFirstChildOfClass("Humanoid").Health <= 0 then

		targetHead = findTarget()
	end

	if not targetHead then
		return
	end

	-- Make sure target is still visible
	if REQUIRE_LINE_OF_SIGHT and not canSee(targetHead) then
		targetHead = findTarget()
		return
	end

	local cameraPosition = Camera.CFrame.Position
	local direction = (targetHead.Position - cameraPosition).Unit

	local desiredCFrame = CFrame.lookAt(
		cameraPosition,
		cameraPosition + direction
	)

	Camera.CFrame = Camera.CFrame:Lerp(
		desiredCFrame,
		SMOOTHNESS
	)
end)
